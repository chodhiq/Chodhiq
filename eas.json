{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_ENABLE_GOOGLE_MAPS": "false",
        "EXPO_PUBLIC_ENABLE_PAYMENTS": "false",
        "EXPO_PUBLIC_ENABLE_GOOGLE_ADS": "false"
      }
    },
    "beta": {
      "channel": "beta",
      "environment": "production",
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_ENABLE_GOOGLE_MAPS": "false",
        "EXPO_PUBLIC_ENABLE_PAYMENTS": "false",
        "EXPO_PUBLIC_ENABLE_CUSTOM_ADS": "true",
        "EXPO_PUBLIC_ENABLE_GOOGLE_ADS": "false"
      }
    },
    "beta-apk": {
      "channel": "beta-internal",
      "environment": "production",
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "beta-internal",
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_ENABLE_GOOGLE_MAPS": "false",
        "EXPO_PUBLIC_ENABLE_PAYMENTS": "false",
        "EXPO_PUBLIC_ENABLE_CUSTOM_ADS": "true",
        "EXPO_PUBLIC_ENABLE_GOOGLE_ADS": "false"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_ENABLE_GOOGLE_MAPS": "false",
        "EXPO_PUBLIC_ENABLE_PAYMENTS": "false",
        "EXPO_PUBLIC_ENABLE_GOOGLE_ADS": "false"
      }
    },
    "production-apk": {
      "channel": "production",
      "environment": "production",
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_ENABLE_GOOGLE_MAPS": "false",
        "EXPO_PUBLIC_ENABLE_PAYMENTS": "false",
        "EXPO_PUBLIC_ENABLE_GOOGLE_ADS": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
