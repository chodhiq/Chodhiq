{
  "name": "chodhiq",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "security:check": "node scripts/security-check.cjs && node scripts/secret-exposure-audit.cjs",
    "launch:config": "node scripts/launch-config-check.cjs",
    "verify:all": "powershell -ExecutionPolicy Bypass -File workspace-scripts/verify-all.ps1",
    "format": "prettier --write App.js src tests scripts",
    "format:check": "prettier --check App.js src tests scripts",
    "quality:check": "node scripts/code-quality-check.cjs",
    "accessibility:check": "node scripts/accessibility-check.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.checked-js.json --noEmit",
    "types:generate": "node workspace-scripts/generate-database-types.mjs",
    "test": "node --experimental-strip-types --test tests/showcase-readiness.test.mjs tests/validation.behavior.test.mjs tests/auth-operations.behavior.test.mjs tests/booking-mapper.behavior.test.mjs tests/schema-contract.test.mjs tests/sync-policy.behavior.test.mjs tests/rate-limit.behavior.test.mjs tests/architecture-boundaries.test.mjs tests/admin-policy-gaps.test.mjs",
    "verify": "npm run security:check && expo export --platform web --output-dir dist-verify --clear",
    "test:e2e:staging": "node --test tests/authenticated-workflows.mjs",
    "test:db": "supabase test db",
    "test:load": "k6 run tests/load-test.k6.js",
    "test:load:report": "k6 run tests/load-test.k6.js --summary-export=load-test-summary.json",
    "test:rls": "echo 'Run db/RLS_AUDIT.sql in Supabase SQL Editor'",
    "verify:release": "npm run format:check && npm run quality:check && npm run accessibility:check && npm run typecheck && npm test && npm run security:check && expo export --platform web --output-dir dist-verify",
    "verify:launch": "npm run launch:config && npm run verify:all"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.45.0",
    "expo": "~54.0.0",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^1.30.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-mobile-ads": "16.0.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "prettier": "3.6.2",
    "supabase": "2.114.0",
    "typescript": "~5.9.2"
  }
}
