EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_SENTRY_DSN=https://your-key@sentry.ingest.sentry.io/your-project-id
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
EXPO_PUBLIC_RELEASE_COMMIT=full-git-commit-hash
EXPO_PUBLIC_BRAND_NAME=ChodhiQ
EXPO_PUBLIC_BRAND_SHORT_NAME=ChodhiQ
EXPO_PUBLIC_SUPPORT_EMAIL=support@chodhiq.app
EXPO_PUBLIC_PRIVACY_EMAIL=privacy@chodhiq.app
EXPO_PUBLIC_BUSINESS_EMAIL=business@chodhiq.app
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_DELETE_ACCOUNT_URL=

# Beta: subscriptions and Google banners off; approved ChodhiQ campaigns may appear.
EXPO_PUBLIC_ENABLE_PAYMENTS=false
EXPO_PUBLIC_ENABLE_CUSTOM_ADS=true
EXPO_PUBLIC_ENABLE_GOOGLE_ADS=false
EXPO_PUBLIC_ENABLE_GOOGLE_MAPS=false
# Required for production native builds. Development automatically uses Google's test banner ID.
EXPO_PUBLIC_GOOGLE_ADS_ANDROID_BANNER_ID=
EXPO_PUBLIC_GOOGLE_ADS_IOS_BANNER_ID=
EXPO_APP_SLUG=chodhiq
EXPO_APP_SCHEME=chodhiq
EXPO_IOS_BUNDLE_ID=com.chodhiq.app
EXPO_ANDROID_PACKAGE=com.chodhiq.app
# Supabase Dashboard → Authentication → URL Configuration must allow:
# chodhiq://auth/callback (development/production build)

# Sentry build-only configuration. Store SENTRY_AUTH_TOKEN as an EAS/GitHub secret;
# it must never use EXPO_PUBLIC_ or be committed.
# SENTRY_ORG=chodhiq
# SENTRY_PROJECT=chodhiq-app
# SENTRY_AUTH_TOKEN=set-in-eas-or-ci-secrets
# SENTRY_URL=https://sentry.io/

# Server-only values below belong in Supabase Edge Function secrets.
# Never prefix these with EXPO_PUBLIC_ and never ship them in the app.
# SUPABASE_SERVICE_ROLE_KEY=set-in-supabase-secrets
# STRIPE_SECRET_KEY=set-in-supabase-secrets
# STRIPE_WEBHOOK_SECRET=set-in-supabase-secrets
# STRIPE_PRICE_COMMUNITY=set-in-supabase-secrets
# STRIPE_PRICE_TOP10=set-in-supabase-secrets
# STRIPE_PRICE_TOP5=set-in-supabase-secrets
# ENABLE_PAYMENTS=false
# Local development (use the exact port your web app runs on):
# ALLOWED_CHECKOUT_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Production example:
# ALLOWED_CHECKOUT_ORIGINS=https://app.example.com,https://admin.example.com
