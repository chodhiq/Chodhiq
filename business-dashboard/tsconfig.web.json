{
  "extends": "./tsconfig.json",
  "compilerOptions": { "incremental": false, "types": ["node"] },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "../packages/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".next",
    "worker",
    "build",
    "db",
    "vite.config.ts",
    "sites-vite-plugin.ts"
  ]
}
