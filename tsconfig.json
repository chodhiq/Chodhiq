{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "incremental": false,
    "skipLibCheck": true
  },
  "include": [
    "App.js",
    "theme.ts",
    "screens/**/*.tsx",
    "src/**/*.js",
    "packages/**/*.js",
    "packages/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-verify", "assets", "supabase", "tests"]
}
